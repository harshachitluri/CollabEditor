[Unit]
Description=CollabCode Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/collabcode/backend
Environment=NODE_ENV=production
Environment=PORT=3001
EnvironmentFile=/opt/collabcode/backend/.env
ExecStart=/usr/bin/npm run start:prod
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
